generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZER
  VOLUNTEER
  PARTICIPANT
}

enum EventCategory {
  CONFERENCE
  PARTY
  SPORT
  CULTURE
  WORKSHOP
  OTHER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  passwordHash String
  role      Role     @default(PARTICIPANT)
  shiftAssignments ShiftAssignment[]
  events    Event[]
  tickets   Ticket[]
  memberships OrganizationMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String        @id @default(uuid())
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime
  location    String
  capacity    Int
  category    EventCategory
  imageUrl    String?
  organizerId String
  organizer   User          @relation(fields: [organizerId], references: [id])
  tickets     Ticket[]
  shifts      Shift[]
  // At least one organization manages an event (enforced by the service, a table constraint cannot count)
  organizations EventOrganization[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([organizerId])
}

enum TicketStatus {
  RESERVED
  CANCELLED
}

model Ticket {
  id            String       @id @default(uuid())
  code          String       @unique
  status        TicketStatus @default(RESERVED)
  checkedInAt   DateTime?
  participantId String
  participant   User         @relation(fields: [participantId], references: [id])
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // One row per participant/event pair: cancel = CANCELLED, rebook = reactivate the row.
  @@unique([eventId, participantId])
  @@index([participantId])
}

model Shift {
  id                 String            @id @default(uuid())
  title              String
  startsAt           DateTime
  endsAt             DateTime
  requiredVolunteers Int
  eventId            String
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments        ShiftAssignment[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([eventId])
}

// Volunteer sign-up for a shift; volunteer is a User with role VOLUNTEER (enforced by the service).
model ShiftAssignment {
  id          String   @id @default(uuid())
  shiftId     String
  shift       Shift    @relation(fields: [shiftId], references: [id])
  volunteerId String
  volunteer   User     @relation(fields: [volunteerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shiftId, volunteerId])
  @@index([volunteerId])
}

enum OrganizationRole {
  MANAGER
  VOLUNTEER
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Organization {
  id              String               @id @default(uuid())
  name            String               @unique
  description     String?
  // Logo stored in the database; always `omit` it from list queries, it can weigh 512 KB
  logo            Bytes?
  logoContentType String?
  members         OrganizationMember[]
  events          EventOrganization[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

// Membership and invitation in one row: PENDING until the invited user accepts.
// A declined invitation keeps its row, so inviting again resets it to PENDING.
model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  role           OrganizationRole
  status         MembershipStatus @default(PENDING)
  invitedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

model EventOrganization {
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@id([eventId, organizationId])
  @@index([organizationId])
}
