generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZER
  VOLUNTEER
  PARTICIPANT
}

enum EventCategory {
  CONFERENCE
  PARTY
  SPORT
  CULTURE
  WORKSHOP
  OTHER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(PARTICIPANT)
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String        @id @default(uuid())
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime
  location    String
  capacity    Int
  category    EventCategory
  imageUrl    String?
  organizerId String
  organizer   User          @relation(fields: [organizerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([organizerId])
}
