PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://gevent:gevent@localhost:5433/gevent?schema=public
# Fournisseur LLM pour la génération de communication : "mock" (défaut, sans réseau) ou "gemini"
# Avec "gemini", la clé gratuite se crée sur https://aistudio.google.com (jamais dans le dépôt).
# Sans clé, le backend retombe sur le mock. Le modèle est facultatif.
LLM_PROVIDER=mock
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=
# Fournisseur d'images : "mock" (défaut) ou "cloudflare" (Workers AI, gratuit, token avec la permission "Workers AI")
IMAGE_PROVIDER=mock
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Secret de signature des JWT (à remplacer, longue chaîne aléatoire) et durée de vie en secondes
JWT_SECRET=change-me-in-dev
JWT_EXPIRES_IN_SECONDS=3600
